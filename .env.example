# AutoForge v1.5 Configuration Template
# AutoForge Runtime Configuration
PORT=4000
HOST=0.0.0.0
CDP_PORT=9222
NODE_ENV=development

# Optional Multimodal & Model Credentials
# (If unset, AutoForge operates in strict local deterministic mode)
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Storage & Artifact Paths
ARTIFACTS_DIR=./artifacts
PUBLIC_DIR=./public
