{
  "name": "autoforge",
  "version": "1.9.0",
  "type": "module",
  "description": "AutoForge — The AI-Native Developer Browser with Multimodal Companion",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && esbuild electron/preload.ts --format=cjs --platform=node --outfile=dist-electron/preload.cjs",
    "preview": "vite preview",
    "start": "electron .",
    "launch": "node scripts/launch.js",
    "server": "tsx src/runtime/server.ts",
    "start:runtime": "tsx src/runtime/server.ts",
    "test:runtime": "tsx src/verifier/test_suite.ts",
    "test:backend": "python -m pytest backend/tests"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.2",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^0.475.0",
    "playwright": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^29.4.6",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
